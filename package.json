{
  "name": "synthetix-enterprise",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @synthetix/web\" \"npm run dev -w @synthetix/server\"",
    "build": "npm run build -w @synthetix/shared && npm run build -w @synthetix/server && npm run build -w @synthetix/web",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "prettier": "^3.9.6",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
